
NEXT_PUBLIC_API_BASE_URL=http://localhost:8082

# Shared secret for server-to-server admin routes - e.g. the dashboard
# "Generate Signals" button POSTing to /api/admin/generate-signals.
# Must match the cluster's `internal-secret` Secret (key: secret).
# When unset the route returns 503 "Server misconfiguration:
# INTERNAL_SECRET not set" instead of failing silently (EXECUTION_PLAN C3).
INTERNAL_SECRET=
