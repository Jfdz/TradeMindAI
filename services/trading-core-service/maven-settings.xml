<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pin Maven Central to Google's GCS-backed mirror.

  The default endpoint repo.maven.apache.org is fronted by Cloudflare and
  intermittently 403s requests from CI runner IPs. Sonatype's historical
  repo1.maven.apache.org alias has no DNS (resolves nowhere), so it is not
  a usable failover. Google's mirror is an officially-listed Maven Central
  mirror backed by Google Cloud Storage on different infrastructure and
  has not been observed throttling CI.

  Reference: https://storage.googleapis.com/maven-central/index.html

  Loaded automatically because the Dockerfile copies this file to
  /root/.m2/settings.xml before the first mvn invocation.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>maven-central-gcs</id>
      <name>Maven Central — Google Cloud Storage mirror</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
