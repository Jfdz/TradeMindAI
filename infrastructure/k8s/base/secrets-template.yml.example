# ╔══════════════════════════════════════════════════════════════════════╗
# ║  ⛔  DO NOT APPLY THIS FILE WITH kubectl apply  ⛔                    ║
# ║  This is documentation only.                                         ║
# ║  Create secrets with `kubectl create secret generic ...` commands    ║
# ║  shown in the comments of each block below.                          ║
# ║                                                                       ║
# ║  NEVER run: kubectl apply -f secrets-template.yml.example            ║
# ║  Doing so will OVERWRITE real cluster credentials with REPLACE_ME.   ║
# ╚══════════════════════════════════════════════════════════════════════╝
#
# ── HOW TO CREATE SECRETS IN A FRESH CLUSTER ─────────────────────────────────
#
#   PG_PASS=$(openssl rand -base64 24)
#   kubectl create secret generic postgres-credentials \
#     --from-literal=host=postgres.trading-saas.svc.cluster.local \
#     --from-literal=username=tradinguser \
#     --from-literal=password="$PG_PASS" \
#     --from-literal=market-data-db=trading_saas \
#     --from-literal=trading-core-db=trading_saas \
#     --from-literal=ai-engine-db=trading_saas \
#     -n trading-saas
#
#   REDIS_PASS=$(openssl rand -base64 24)
#   kubectl create secret generic redis-credentials \
#     --from-literal=host=redis.trading-saas.svc.cluster.local \
#     --from-literal=password="$REDIS_PASS" \
#     -n trading-saas
#   # Also set on the server: kubectl exec -n trading-saas redis-0 -- redis-cli CONFIG SET requirepass "$REDIS_PASS"
#
#   RABBIT_PASS=$(openssl rand -base64 24)
#   kubectl create secret generic rabbitmq-credentials \
#     --from-literal=host=rabbitmq.trading-saas.svc.cluster.local \
#     --from-literal=username=tradinguser \
#     --from-literal=password="$RABBIT_PASS" \
#     -n trading-saas
#   # Also set on server: kubectl exec -n trading-saas rabbitmq-0 -- rabbitmqctl change_password tradinguser "$RABBIT_PASS"
#
#   kubectl create secret generic jwt-secret \
#     --from-literal=secret=$(openssl rand -base64 48) \
#     -n trading-saas
#
#   kubectl create secret generic nextauth-secret \
#     --from-literal=secret=$(openssl rand -base64 32) \
#     -n trading-saas
#
#   INTERNAL_SECRET=$(openssl rand -hex 32)
#   kubectl create secret generic internal-secret \
#     --from-literal=secret="$INTERNAL_SECRET" \
#     -n trading-saas
#
# ── KNOWN IN-CLUSTER HOSTNAMES (base64 reference) ────────────────────────────
#   postgres.trading-saas.svc.cluster.local → cG9zdGdyZXMudHJhZGluZy1zYWFzLnN2Yy5jbHVzdGVyLmxvY2Fs
#   redis.trading-saas.svc.cluster.local    → cmVkaXMudHJhZGluZy1zYWFzLnN2Yy5jbHVzdGVyLmxvY2Fs
#   rabbitmq.trading-saas.svc.cluster.local → cmFiYml0bXEudHJhZGluZy1zYWFzLnN2Yy5jbHVzdGVyLmxvY2Fs
#   trading_saas (db name)                  → dHJhZGluZ19zYWFz
#   tradinguser (db user)                  → dHJhZGluZ191c2Vy
#
# ── STRUCTURE REFERENCE (keys each Secret must have) ─────────────────────────

---
# Secret: postgres-credentials
# Keys: host, username, password, market-data-db, trading-core-db, ai-engine-db
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: trading-saas
type: Opaque
data:
  host: cG9zdGdyZXMudHJhZGluZy1zYWFzLnN2Yy5jbHVzdGVyLmxvY2Fs  # postgres.trading-saas.svc.cluster.local
  username: dHJhZGluZ191c2Vy                                      # tradinguser
  password: REPLACE_ME_DO_NOT_APPLY                               # openssl rand -base64 24
  market-data-db: dHJhZGluZ19zYWFz                                # trading_saas
  trading-core-db: dHJhZGluZ19zYWFz                               # trading_saas
  ai-engine-db: dHJhZGluZ19zYWFz                                  # trading_saas

---
# Secret: redis-credentials
# Keys: host, password
apiVersion: v1
kind: Secret
metadata:
  name: redis-credentials
  namespace: trading-saas
type: Opaque
data:
  host: cmVkaXMudHJhZGluZy1zYWFzLnN2Yy5jbHVzdGVyLmxvY2Fs  # redis.trading-saas.svc.cluster.local
  password: REPLACE_ME_DO_NOT_APPLY                          # openssl rand -base64 24

---
# Secret: rabbitmq-credentials
# Keys: host, username, password
apiVersion: v1
kind: Secret
metadata:
  name: rabbitmq-credentials
  namespace: trading-saas
type: Opaque
data:
  host: cmFiYml0bXEudHJhZGluZy1zYWFzLnN2Yy5jbHVzdGVyLmxvY2Fs  # rabbitmq.trading-saas.svc.cluster.local
  username: dHJhZGluZ191c2Vy                                      # tradinguser
  password: REPLACE_ME_DO_NOT_APPLY                               # openssl rand -base64 24

---
# Secret: jwt-secret
# Keys: secret
apiVersion: v1
kind: Secret
metadata:
  name: jwt-secret
  namespace: trading-saas
type: Opaque
data:
  secret: REPLACE_ME_DO_NOT_APPLY  # openssl rand -base64 48 (minimum 256-bit)

---
# Secret: nextauth-secret
# Keys: secret
apiVersion: v1
kind: Secret
metadata:
  name: nextauth-secret
  namespace: trading-saas
type: Opaque
data:
  secret: REPLACE_ME_DO_NOT_APPLY  # openssl rand -base64 32

---
# Secret: finnhub-credentials
# Keys: api-key
# Create with:
#   kubectl create secret generic finnhub-credentials \
#     --from-literal=api-key="<your-finnhub-api-key>" \
#     -n trading-saas
apiVersion: v1
kind: Secret
metadata:
  name: finnhub-credentials
  namespace: trading-saas
type: Opaque
data:
  api-key: REPLACE_ME_DO_NOT_APPLY  # base64-encoded Finnhub API key

---
# Secret: internal-secret
# Keys: secret
apiVersion: v1
kind: Secret
metadata:
  name: internal-secret
  namespace: trading-saas
type: Opaque
data:
  secret: REPLACE_ME_DO_NOT_APPLY  # openssl rand -hex 32
